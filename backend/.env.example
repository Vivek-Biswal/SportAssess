# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Replace with your MongoDB Atlas URI or local MongoDB URI
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/sportassess?retryWrites=true&w=majority

# Authentication
# Generate a strong secret key (e.g., using `openssl rand -base64 32`)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# External AI / CV Service Integration (Managed by teammate)
CV_SERVICE_URL=https://api.example.com/cv
CV_SERVICE_API_KEY=your_cv_service_api_key

# Storage Provider (e.g., AWS S3, Cloudinary, etc.)
STORAGE_PROVIDER=mock
STORAGE_BUCKET=sportassess-videos
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
